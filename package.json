{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:server": "pnpm --filter @workspace/api-server build",
    "start:server": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "build:frontend": "pnpm --filter @workspace/pos-ventas build",
    "db:push": "pnpm --filter @workspace/db push",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
